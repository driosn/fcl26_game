<Rive version="1" kind="fragment">
    <!--
        Flutter Dash as a guerrilla, eight 3/4 poses.
        World artboards: BugGrunt, BugRunner, BugTank, Tracer, Pickup.
        Hud: top bar, Dash health tank, plates.

        facing: 0 down, 1 down-right, 2 right, 3 up-right,
        4 up, 5 up-left, 6 left, 7 down-left.
        Each pose is its own node; a state-machine layer swaps opacity.
        Drawings stay simple on purpose — sphere, mask, beak, bandana, gun —
        so the bird reads at 120px and the rifle is a real silhouette.
    -->
    <Artboard defaultStateMachineId="0:60" styleId="0:5" viewModelId="0:90"
              viewModelInstanceId="0:95" width="200" height="200"
              name="DashRambo" id="0:2">
        <LayoutComponentStyle name="Artboard Style" id="0:5"/>

        <Node x="100" y="108" name="Dash" id="0:20">

